# =============================================================================
# Downloads — share de arquivos
# =============================================================================
# Caminho raiz onde estão os arquivos servidos por /downloads.
#
# Produção (servidor interno): caminho UNC do share.
#   DOWNLOADS_ROOT=\\10.1.1.1\web
# Se o Next.js rodar na mesma máquina dos arquivos, prefira caminho local:
#   DOWNLOADS_ROOT=D:\web
#
# Desenvolvimento: aponte pra uma pasta local de teste com a mesma estrutura
# (apk\, publico\, privado\, Radmin.exe, vnc.exe).
#   DOWNLOADS_ROOT=D:\test\web
DOWNLOADS_ROOT=

# Credenciais HTTP Basic Auth da área /downloads/privado.
# Único par user/senha pra todos os colaboradores.
DOWNLOADS_USER=
DOWNLOADS_PASS=
